# Postgres
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=corpus
POSTGRES_PASSWORD=corpus
POSTGRES_DB=living_corpus

# Weaviate
WEAVIATE_URL=http://localhost:8080
WEAVIATE_GRPC_PORT=50051

# Corpus worktrees (sibling checkouts of the Pydantic repo at different
# points in its v2 history). Paths are relative to the project root.
CORPUS_PATH_EARLY=../pyd-v2early
CORPUS_PATH_MID=../pyd-v2mid
CORPUS_PATH_LATE=../pyd-v2late

# API
API_HOST=0.0.0.0
API_PORT=8000
